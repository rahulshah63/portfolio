---
import ArrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg';
import GitHubLogo from '@phosphor-icons/core/assets/fill/github-logo-fill.svg';
import Minus from '@phosphor-icons/core/assets/regular/minus.svg';
import Plus from '@phosphor-icons/core/assets/regular/plus.svg';
import BrandLogo from '../components/BrandLogo.astro';
import HeroArt from '../components/HeroArt.astro';
import Sketch from '../components/Sketch.astro';
import Words from '../components/Words.astro';
import Base from '../layouts/Base.astro';
import { formatDate, getPosts } from '../posts';
import { academicProjects, awards, education, nonprofits, papers, projects, site, work } from '../site';

const posts = (await getPosts()).slice(0, 3);
---

<Base>
	<section class="hero">
		<div class="hero-copy">
			<h1><Words text={site.name} /></h1>
			<p class="lede" data-enter style="--d: 450ms; --rise: 10px">{site.intro}</p>
			<div class="actions" data-enter style="--d: 550ms; --rise: 10px">
				<button type="button" class="button button-primary" popovertarget="contact">Contact</button>
				<a href={site.cv} class="button" target="_blank" rel="noopener">
					View CV
				</a>
			</div>
		</div>
		<HeroArt />
	</section>

	<section class="section section-grid" id="work" data-reveal>
		<h2 class="label">Work</h2>
		<ol class="rows">
			{
				work.map((role) => (
					<li>
						<span class="date">{role.period}</span>
						<div>
							<h3>
								{role.url ? <a href={role.url} class="sweep">{role.company}</a> : role.company}
							</h3>
							{role.title && <p class="small muted">{role.title}</p>}
							<p class="summary" set:html={role.summary} />
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section section-grid" id="projects" data-reveal>
		<h2 class="label">Projects</h2>
		<div>
			<ul class="cards">
			{
				projects.map((project) => (
					<li>
						<div class="tile" style={`--tone: ${project.tone}`}>
							{project.logo ? <BrandLogo name={project.logo} /> : <Sketch name={project.sketch} />}
						</div>
						<h3>{project.name}</h3>
						<p class="summary">{project.summary}</p>
						{project.links.length > 0 && (
							<p class="card-links">
								{project.links.map((link) => (
									link.href ? (
										<a href={link.href}>
											{link.label}
											<ArrowUpRight class="icon" aria-hidden="true" />
										</a>
									) : (
										<span class="plain">{link.label}</span>
									)
								))}
							</p>
						)}
					</li>
				))
			}
		</ul>
		<details class="more-wrap">
			<summary>
				<span>Academic projects</span>
				<Plus class="icon plus" aria-hidden="true" />
				<Minus class="icon minus" aria-hidden="true" />
			</summary>
			<ul class="more">
				{
					academicProjects.map((project) => (
						<li>
							<h4>{project.name}</h4>
							<p>{project.summary}</p>
							{project.links.length > 0 && (
								<p class="card-links">
									{project.links.map((link) => (
										<a href={link.href}>
											{link.label}
											<ArrowUpRight class="icon" aria-hidden="true" />
										</a>
									))}
								</p>
							)}
						</li>
					))
				}
			</ul>
		</details>
		<a href={site.links.github} class="sheen-button">
			<span class="sheen" aria-hidden="true"></span>
			<GitHubLogo class="icon" aria-hidden="true" />
			<span>More on GitHub</span>
		</a>
		</div>
	</section>

	<section class="section section-grid" id="nonprofits" data-reveal>
		<h2 class="label">Non-profit</h2>
		<ul class="ngos">
			{
				nonprofits.map((org) => (
					<li>
						<div class="tile tile-square" style={`--tone: ${org.tone}`}>
							<Sketch name={org.sketch} />
						</div>
						<div>
							<h3>{org.name}</h3>
							<p class="summary">{org.summary}</p>
							<p class="card-links">
								{org.links.map((link) => (
									<a href={link.href}>
										{link.label}
										<ArrowUpRight class="icon" aria-hidden="true" />
									</a>
								))}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section section-grid" id="education" data-reveal>
		<h2 class="label">Education</h2>
		<ol class="rows">
			{
				education.map((entry) => (
					<li>
						<span class="date">{entry.period}</span>
						<div>
							<h3>{entry.degree}</h3>
							<p class="summary">{entry.school}</p>
							<ul class="highlights">
								{entry.highlights.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section section-grid" id="recognition" data-reveal>
		<h2 class="label">Recognition</h2>
		<div>
			<h3 class="group-label">Papers</h3>
			<ul class="papers">
				{
					papers.map((paper) => (
						<li>
							<p class="paper-meta">
								<span>{paper.venue}</span>
								<span class="date">{paper.year}</span>
							</p>
							<h4>{paper.title}</h4>
							<a href={paper.href} class="small">
								Read the paper
								<ArrowUpRight class="icon" aria-hidden="true" />
							</a>
						</li>
					))
				}
			</ul>

			<h3 class="group-label">Awards and fellowships</h3>
			<ul class="awards">
				{
					awards.map((award) => (
						<li>
							<span class="date">{award.year}</span>
							<h4>{award.href ? <a href={award.href}>{award.title}</a> : award.title}</h4>
							<span class="award-detail">{award.detail}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section cv" data-reveal>
		<h2>Want the full picture?</h2>
		<p>My CV has the full story: work, projects, education and achievements.</p>
		<div class="actions">
			<a href={site.cv} class="button button-primary" target="_blank" rel="noopener">
				View CV
			</a>
			<button type="button" class="button" popovertarget="contact">Contact</button>
		</div>
	</section>
	{
		posts.length > 0 && (
			<section class="section section-grid" id="notes" data-reveal>
				<h2 class="label">Notes</h2>
				<div>
					<ul class="note-cards">
						{posts.map((post) => (
							<li>
								<a href={`/notes/${post.id}/`}>
									<div class="tile">
										<Sketch name={post.data.illustration} />
									</div>
									<p class="date">
										<span class="note-category">{post.data.category}</span>
										<span aria-hidden="true"> · </span>
										<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
									</p>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
					<a href="/notes/" class="button all-notes">All notes</a>
				</div>
			</section>
		)
	}
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: center;
		gap: 48px;
		padding-block: 72px 80px;
	}

	.hero h1 {
		font-size: clamp(3rem, 7vw, 4.75rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
	}

	.lede {
		margin-top: 1.25rem;
		max-width: 44ch;
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 2rem;
	}

	.hero :global(.hero-art) {
		width: 100%;
		max-width: 400px;
		justify-self: center;
		--stroke: 5;
	}


	.all-notes {
		margin-top: 40px;
	}

	.note-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
	}

	.note-cards a {
		display: block;
		text-decoration: none;
	}

	.note-cards .date {
		display: block;
		margin-top: 1rem;
	}

	.note-category {
		color: var(--text-2);
		font-weight: 600;
	}

	.note-cards h3 {
		margin-top: 0.3rem;
		font-size: 1.25rem;
		line-height: 1.25;
	}

	.note-cards p {
		margin-top: 0.4rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.note-cards a:hover h3 {
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 3px;
	}

	.rows > li {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		gap: 24px;
		padding-block: 24px;
		border-top: 1px solid var(--line);
	}

	.rows > li:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.rows .date {
		line-height: 1.9;
	}

	.rows h3 {
		font-size: 1.5rem;
	}



	.rows h3 + .small {
		margin-top: 0.25rem;
	}

	.summary {
		margin-top: 0.5rem;
		color: var(--text-2);
		font-size: 1rem;
		max-width: 62ch;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 48px 32px;
	}

	.cards :global(.tile .brand-logo) {
		width: 32%;
		height: auto;
		max-height: none;
	}

	.cards :global(.tile .brand-aleo) {
		width: 52%;
	}

	.cards h3 {
		margin-top: 1.25rem;
		font-size: 1.375rem;
	}

	.cards .summary {
		color: var(--muted);
		font-size: 0.9688rem;
	}

	.card-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
	}

	.card-links .plain {
		color: var(--muted);
	}

	.card-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.more-wrap {
		margin-top: 56px;
		border-block: 1px solid var(--line);
	}

	.more-wrap summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 20px;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	.more-wrap summary::-webkit-details-marker {
		display: none;
	}

	.more-wrap summary .icon {
		font-size: 1.25rem;
		color: var(--text-2);
		transition: color 0.2s ease;
	}

	.more-wrap summary:hover .icon {
		color: var(--text);
	}

	.more-wrap .minus,
	.more-wrap[open] .plus {
		display: none;
	}

	.more-wrap[open] .minus {
		display: block;
	}

	/* Slide open where the browser can animate to auto height; elsewhere it just opens. */
	.more-wrap::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			content-visibility 0.45s allow-discrete;
	}

	.more-wrap[open]::details-content {
		block-size: auto;
	}

	.more-wrap .more {
		padding-bottom: 8px;
	}

	/* Pill with a light sweeping across it, after the "New" button in Elitra, in black and white. */
	.sheen-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 40px;
		margin-top: 28px;
		padding: 0 20px;
		overflow: hidden;
		border-radius: 999px;
		background: linear-gradient(115deg, var(--text) 0%, var(--text) 45%, color-mix(in srgb, var(--text) 78%, var(--bg)) 125%);
		box-shadow: 0 6px 20px color-mix(in srgb, var(--text) 22%, transparent);
		color: var(--bg);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: box-shadow 0.2s ease, transform 0.1s ease;
	}

	.sheen-button:hover {
		box-shadow: 0 8px 26px color-mix(in srgb, var(--text) 32%, transparent);
	}

	.sheen-button:active {
		transform: scale(0.98);
	}

	.sheen-button > :not(.sheen) {
		position: relative;
	}

	.sheen-button .icon {
		font-size: 1rem;
	}

	.sheen {
		position: absolute;
		inset-block: 0;
		left: 0;
		width: 42%;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bg) 35%, transparent), transparent);
		animation: sheen 3.4s ease-in-out infinite;
	}

	@keyframes sheen {
		0% {
			transform: translateX(-160%) skewX(-18deg);
		}
		100% {
			transform: translateX(360%) skewX(-18deg);
		}
	}

	.more {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 32px;
	}

	.more li {
		padding-block: 20px;
		border-top: 1px solid var(--line);
	}

	.more h4 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.1875rem;
		font-weight: 500;
		line-height: 1.25;
	}

	.more p {
		margin-top: 0.35rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.more .card-links {
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		color: var(--text);
	}

	.ngos {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px;
	}

	.ngos li {
		display: grid;
		grid-template-columns: 132px minmax(0, 1fr);
		gap: 24px;
		align-items: start;
	}

	/* Text column fills the row, so both entries end with their links on the same line. */
	.ngos li > div:last-child {
		display: flex;
		flex-direction: column;
		align-self: stretch;
	}

	.ngos li > div:last-child .card-links {
		margin-top: auto;
		padding-top: 0.75rem;
	}

	.ngos .tile .sketch,
	.ngos :global(.tile .sketch) {
		width: 70%;
	}

	.ngos h3 {
		font-size: 1.375rem;
	}

	.ngos .summary {
		color: var(--muted);
		font-size: 0.9688rem;
	}

	.ngos .card-links {
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.highlights {
		display: grid;
		gap: 0.4rem;
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--text-2);
	}

	.highlights li::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 0.6rem;
		border-radius: 999px;
		background: var(--text);
		vertical-align: middle;
	}

	.group-label {
		margin-bottom: 20px;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.papers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.papers li {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 24px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--surface);
	}

	.paper-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.875rem;
		color: var(--text-2);
	}

	.papers h4 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.3125rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.papers a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-top: auto;
		padding-top: 0.5rem;
		align-self: flex-start;
	}

	.papers + .group-label {
		margin-top: 48px;
	}

	.awards li {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 24px;
		padding-block: 16px;
		border-top: 1px solid var(--line);
	}

	.awards li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.awards h4 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.1875rem;
		font-weight: 500;
	}

	.award-detail {
		font-size: 0.9375rem;
		color: var(--muted);
		text-align: right;
	}

	.cv {
		text-align: center;
		padding-block: 88px;
	}

	.cv h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
	}

	.cv p {
		margin-top: 0.75rem;
		font-size: 1.125rem;
		color: var(--muted);
	}

	.cv .actions {
		justify-content: center;
	}

	@media (max-width: 767px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
			padding-block: 48px 56px;
		}

		.hero :global(.hero-art) {
			max-width: 260px;
			justify-self: center;
		}


		.rows > li {
			grid-template-columns: minmax(0, 1fr);
			gap: 4px;
		}

		.cards,
		.more,
		.ngos,
		.note-cards {
			grid-template-columns: minmax(0, 1fr);
		}

		.ngos li {
			grid-template-columns: 96px minmax(0, 1fr);
			gap: 18px;
		}

		.cv {
			padding-block: 64px;
		}

		.papers {
			grid-template-columns: minmax(0, 1fr);
		}

		.awards li {
			grid-template-columns: minmax(0, 1fr);
			gap: 2px;
		}

		.awards .date:empty {
			display: none;
		}

		.award-detail {
			text-align: left;
		}
	}
</style>
