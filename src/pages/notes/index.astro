---
import Sketch from '../../components/Sketch.astro';
import Words from '../../components/Words.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingMinutes } from '../../posts';

const posts = await getPosts();
---

<Base title="Notes" description="Notes and thoughts by Rahul Shah.">
	<div class="notes">
		<header class="notes-head">
			<h1><Words text="Notes" /></h1>
			<p data-enter style="--d: 400ms; --rise: 10px">Notes and thoughts on what I build and learn.</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Nothing published yet.</p>
			) : (
				<ul class="grid" data-enter style="--d: 550ms">
					{posts.map((post) => (
						<li>
							<a href={`/notes/${post.id}/`}>
								<div class="tile">
									<Sketch name={post.data.illustration} />
								</div>
								<p class="meta">
									<span class="category">{post.data.category}</span>
									<span aria-hidden="true">·</span>
									<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
									<span aria-hidden="true">·</span>
									<span>{readingMinutes(post)} min read</span>
									{post.data.draft && <span class="draft">Draft</span>}
								</p>
								<h2>{post.data.title}</h2>
								<p class="description">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>

<style>
	/* Same column as a note: 70% of the screen on desktop, 90% on phones. */
	.notes {
		width: 70vw;
		max-width: 100%;
		margin-inline: auto;
	}

	.notes-head {
		padding-block: 64px 40px;
		border-bottom: 1px solid var(--line);
	}

	h1 {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.015em;
	}

	.notes-head p {
		margin-top: 0.75rem;
		font-size: 1.125rem;
		color: var(--muted);
	}

	.empty {
		padding-top: 40px;
		color: var(--muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 48px 28px;
		padding-top: 48px;
	}

	.grid a {
		display: block;
		text-decoration: none;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.category {
		color: var(--text-2);
		font-weight: 600;
	}

	.draft {
		margin-left: 0.25rem;
		padding: 1px 8px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		font-size: 0.75rem;
	}

	h2 {
		margin-top: 0.35rem;
		font-size: 1.375rem;
		line-height: 1.2;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 4px;
		transition: text-decoration-color 0.2s ease;
	}

	.grid a:hover h2 {
		text-decoration-color: var(--line-strong);
	}

	.description {
		margin-top: 0.4rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	@media (max-width: 767px) {
		.notes {
			width: 90vw;
		}

		.notes-head {
			padding-block: 40px 28px;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 32px 14px;
			padding-top: 28px;
		}

		.meta {
			margin-top: 0.75rem;
			font-size: 0.75rem;
			gap: 0.35rem;
		}

		h2 {
			font-size: 1.0625rem;
			line-height: 1.25;
		}

		.description {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 3;
			overflow: hidden;
			font-size: 0.8125rem;
		}
	}
</style>
