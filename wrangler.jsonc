{
  // Static site on Cloudflare Workers. `npm run deploy` builds and uploads dist/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahul-shah-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "rahul-shah.com.np", "custom_domain": true },
    { "pattern": "www.rahul-shah.com.np", "custom_domain": true }
  ]
}
